# Скопируйте этот файл в .env и заполните. Файл .env никогда не коммитьте!

# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Папка для данных пользователей (last_places.json, saved_places.json).
# Пусто — папка с bot.py. В Docker задаётся автоматически: /data
DATA_DIR=

# Токен WAQI (aqicn.org) для качества воздуха по ближайшей станции — по желанию.
# Получить бесплатно: https://aqicn.org/data-platform/token/  Без токена бот берёт Open-Meteo.
WAQI_TOKEN=
